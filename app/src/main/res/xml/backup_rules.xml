<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9–11: Android's own backup may include Tally's data only when it is end-to-end encrypted, so an
     unencrypted copy (for example "adb backup") never carries the notebook. The auto backup's folder grant and what was
     asked about permissions only mean something on this phone, so they are left out, as are the auto backup's copy of
     the data (made again at the next start) and half-written temporary files. -->
<full-backup-content>
    <include domain="root" path="." requireFlags="clientSideEncryption" />
    <include domain="file" path="." requireFlags="clientSideEncryption" />
    <include domain="database" path="." requireFlags="clientSideEncryption" />
    <include domain="sharedpref" path="." requireFlags="clientSideEncryption" />
    <exclude domain="sharedpref" path="tally_backup.xml" />
    <exclude domain="sharedpref" path="tally_perms.xml" />
    <exclude domain="file" path="snapshot.json" />
    <exclude domain="file" path="snapshot.json.tmp" />
    <exclude domain="file" path="saved.json.tmp" />
</full-backup-content>
