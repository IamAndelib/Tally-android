<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup only where it is end-to-end encrypted; a direct phone-to-phone transfer is fine. The auto
     backup's folder grant and what was asked about permissions only mean something on this phone, so they are left out
     of both, as are the auto backup's copy of the data (made again at the next start) and half-written temporary
     files. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="tally_backup.xml" />
        <exclude domain="sharedpref" path="tally_perms.xml" />
        <exclude domain="file" path="snapshot.json" />
        <exclude domain="file" path="snapshot.json.tmp" />
        <exclude domain="file" path="saved.json.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tally_backup.xml" />
        <exclude domain="sharedpref" path="tally_perms.xml" />
        <exclude domain="file" path="snapshot.json" />
        <exclude domain="file" path="snapshot.json.tmp" />
        <exclude domain="file" path="saved.json.tmp" />
    </device-transfer>
</data-extraction-rules>
