<resources>
    <!-- Android 13+: as values-v31, and the splash shows the logo however the app is opened (home-screen widget,
         its quick add, a reminder), not only from the launcher icon; otherwise those launches get a plain colour -->
    <style name="AppTheme" parent="AppTheme.Base">
        <item name="android:windowSplashScreenBackground">@color/surface</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
</resources>
