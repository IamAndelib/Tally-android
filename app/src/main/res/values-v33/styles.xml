<resources>
    <!-- Android 13+: as values-v31, and the splash prefers the logo whenever the caller doesn't choose a style. The home
         screen does choose a plain colour for widget taps, which is why the widget body goes through OpenActivity -->
    <style name="AppTheme" parent="AppTheme.Base">
        <item name="android:windowSplashScreenBackground">@color/surface</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
</resources>
